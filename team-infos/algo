function autoSaveEditData() {
  if (editSlotIndex !== null && team[editSlotIndex]) {
    team[editSlotIndex].level = parseInt(DOM.levelInput.value) || 100;
    
    // Função auxiliar para recuperar o valor do dataset e transformá-lo em objeto se necessário
    const getSelectVal = (id) => {
      const val = document.getElementById(id).dataset.value;
      if (!val) return "";
      try { if (val.startsWith('{')) return JSON.parse(val); } catch(e) {}
      return val;
    };

    team[editSlotIndex].moves = [
      getSelectVal('moveSelect0'),
      getSelectVal('moveSelect1'),
      getSelectVal('moveSelect2'),
      getSelectVal('moveSelect3')
    ];
    saveData();
    renderTeam();
  }
}
