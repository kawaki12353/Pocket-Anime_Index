function getMoveHtml(moveInput) {
  if (!moveInput) return `<span class="move-name-txt">${texts[lang].moveEmpty}</span>`;

  const minfo = getMoveInfo(moveInput);
  if (!minfo) return `<span class="move-name-txt">${texts[lang].moveEmpty}</span>`;

  // 🔥 Detecta se tem level
  const levelText = (typeof moveInput === "object" && moveInput.level)
    ? `<span class="move-level">Lv.${moveInput.level}</span> `
    : "";

  return `
    <div class="move-wrapper">
      ${levelText}
      <span class="move-name-txt">${minfo.name}</span>
      <div class="move-icons-wrapper">
        <img src="assets/${minfo.typeStr}_element.png" class="move-icon-type">
        <img src="assets/${minfo.attackStr}.png" class="move-icon-atk">
      </div>
    </div>
  `;
}