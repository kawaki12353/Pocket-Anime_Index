/* Função Auxiliar para resgatar infos de um Move */
function getMoveInfo(moveInput) {
  if (!moveInput || moveInput === "") return null;

  let moveData = null;
  // Se o input for apenas o nome (string), procuramos no array moves
  let searchName = typeof moveInput === 'string' ? moveInput.trim() : (moveInput.name || "");

  if (typeof moves !== "undefined" && Array.isArray(moves)) {
    moveData = moves.find(m => m.name.toLowerCase() === searchName.toLowerCase());
  }

  // Se não encontrar no banco de dados, retorna um objeto básico com o nome que recebeu
  if (!moveData) {
    return { 
      name: searchName, 
      typeStr: "neutral", 
      attackStr: "physical" 
    };
  }

  // Mapeamento e normalização para minúsculo (essencial para as imagens)
  return {
    name: moveData.name,
    typeStr: String(moveData.type || "neutral").toLowerCase().trim(),
    attackStr: String(moveData.attack || "physical").toLowerCase().trim()
  };
}