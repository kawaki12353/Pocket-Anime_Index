function getMoveInfo(moveInput, localMoveList = null) {
  if (!moveInput || moveInput === "") return null;

  let moveData = null;
  const finalName = typeof moveInput === "string"
    ? moveInput.trim().toLowerCase()
    : null;

  // 1️⃣ Procura primeiro na lista local do animon
  if (localMoveList && Array.isArray(localMoveList)) {
    moveData = localMoveList.find(m =>
      m.name && m.name.toLowerCase().trim() === finalName
    );
  }

  // 2️⃣ Se não achou, procura no moves.js global
  if (!moveData && typeof moves !== "undefined") {
    const moveArray = Array.isArray(moves)
      ? moves
      : Object.values(moves);

    moveData = moveArray.find(m =>
      m.name && m.name.toLowerCase().trim() === finalName
    );
  }

  if (!moveData) return null;

  return {
    name: moveData.name,
    typeStr: String(moveData.type).toLowerCase().trim(),
    attackStr: String(moveData.attack).toLowerCase().trim()
  };
}