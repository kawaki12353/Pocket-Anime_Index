function createMoveSelect(containerId, currentMove, availableMoves) {
  const container = document.getElementById(containerId);
  const label = texts[lang].moveSelect;

  let optionsHtml = `<div class="option" data-value=""><span class="move-name-txt">-- ${texts[lang].moveEmpty} --</span></div>`;

  availableMoves.forEach(m => {
    // Se 'm' for um objeto, converte para string JSON para não perder os dados vitais.
    const mData = typeof m === 'object' ? JSON.stringify(m).replace(/"/g, '&quot;') : m;
    optionsHtml += `<div class="option" data-value="${mData}">${getMoveHtml(m)}</div>`;
  });

  container.innerHTML = `
    <div class="select-btn">
      ${currentMove ? getMoveHtml(currentMove) : `<span class="move-name-txt">${label}</span>`}
    </div>
    <div class="select-options">${optionsHtml}</div>
  `;

  const btn = container.querySelector('.select-btn');
  const options = container.querySelector('.select-options');

  btn.onclick = (e) => {
    e.stopPropagation();
    document.querySelectorAll('.select-options').forEach(opt => { if (opt !== options) opt.classList.remove('open'); });
    options.classList.toggle('open');
  };

  container.querySelectorAll('.option').forEach(opt => {
    opt.onclick = () => {
      const val = opt.dataset.value;
      
      // Tenta converter de volta para objeto se for um JSON salvo
      let parsedVal = val;
      try { if (val.startsWith('{')) parsedVal = JSON.parse(val); } catch(e) {}

      btn.innerHTML = val ? getMoveHtml(parsedVal) : `<span class="move-name-txt">${label}</span>`;
      container.dataset.value = val;
      options.classList.remove('open');
      autoSaveEditData();
    };
  });
  
  // Lida corretamente com objetos vindos de carregamentos anteriores (evita "[object Object]")
  const initialVal = typeof currentMove === 'object' ? JSON.stringify(currentMove) : (currentMove || "");
  container.dataset.value = initialVal;
}
