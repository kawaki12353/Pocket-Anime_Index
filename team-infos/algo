/* Função Auxiliar para resgatar infos de um Move com busca aprimorada */
function getMoveInfo(moveInput) {
  if (!moveInput || moveInput === "" || moveInput === "None") return null;

  let moveData = null;
  let finalName = typeof moveInput === 'string' ? moveInput.trim() : (moveInput.name || "Unknown");

  // Busca no objeto global 'moves' (carregado do moves.js)
  if (typeof moves !== "undefined") {
    // Se 'moves' for um objeto onde a chave é o nome do golpe
    if (moves[finalName]) {
      moveData = moves[finalName];
    } else {
      // Busca ignorando maiúsculas/minúsculas
      const foundKey = Object.keys(moves).find(k => k.toLowerCase() === finalName.toLowerCase());
      if (foundKey) {
        moveData = moves[foundKey];
        finalName = foundKey;
      }
    }
  }

  // Se não encontrar os dados, tenta usar o que veio no input (caso o objeto já tenha as propriedades)
  if (!moveData && typeof moveInput === 'object') {
    moveData = moveInput;
  }

  // Se mesmo assim não encontrar no banco de dados, retorna o nome mas mantém ícones padrão para não quebrar
  if (!moveData) return { name: finalName, typeStr: "neutral", attackStr: "physical" };

  // Mapeamento dos campos (aceita 'type' ou 'element' e 'attack' ou 'category')
  const tVal = moveData.type || moveData.element || "neutral";
  const typeValue = Array.isArray(tVal) ? tVal[0] : tVal;
  
  const aVal = moveData.attack || moveData.category || moveData.damage_class || "physical";

  return {
    name: moveData.name || finalName,
    typeStr: String(typeValue).toLowerCase().trim(),
    attackStr: String(aVal).toLowerCase().trim()
  };
}
